{
  "name": "cdfir",
  "version": "0.1.0",
  "private": true,
  "description": "AEG-CloudDFIR — self-hostable multi-provider email and drive forensic archive and eDiscovery production platform",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:verify": "tsx scripts/audit-verify.ts",
    "sbom:generate": "tsx scripts/generate-sbom.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@aeg-clouddfir/config": "workspace:*",
    "@aeg-clouddfir/connectors": "workspace:*",
    "@aeg-clouddfir/database": "workspace:*",
    "@aeg-clouddfir/evidence": "workspace:*",
    "@aeg-clouddfir/search": "workspace:*",
    "@playwright/test": "1.62.1",
    "@types/node": "26.1.2",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.9",
    "turbo": "^2.10.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}

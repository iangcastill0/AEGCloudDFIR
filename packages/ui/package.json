{
  "name": "@evidencevault/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./components.css": "./dist/components.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/tokens.css src/components.css src/styles.css dist/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "eslint": "^10.8.0",
    "react": "^19.2.8",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}

{
  "name": "@aeg-clouddfir/evidence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "storage:check": "node dist/storage-check-cli.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1105.0",
    "@aws-sdk/lib-storage": "3.1105.0",
    "@aws-sdk/s3-request-presigner": "3.1105.0",
    "@aeg-clouddfir/config": "workspace:*",
    "mailparser": "3.9.15",
    "sanitize-html": "2.17.6"
  },
  "devDependencies": {
    "@types/mailparser": "3.4.6",
    "@types/node": "26.1.2",
    "@types/sanitize-html": "2.16.1",
    "aws-sdk-client-mock": "4.1.0",
    "eslint": "^10.8.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}

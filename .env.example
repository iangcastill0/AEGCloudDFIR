# ============================================================================
# AEG-CloudDFIR environment configuration
# Copy to .env and adjust. Every service validates this at startup and exits
# with a per-key error report if anything is missing or malformed.
# NEVER commit a real .env. Values below are local-development placeholders
# that match infra/compose/docker-compose.yml, not production secrets.
# ============================================================================

NODE_ENV=development
EV_APP_VERSION=0.1.0

# --- HTTP -------------------------------------------------------------------
EV_API_PORT=4000
EV_API_PUBLIC_URL=http://localhost:4000
EV_WEB_PUBLIC_URL=http://localhost:3000
# Set true only behind a TLS-terminating reverse proxy that sets X-Forwarded-*
EV_TRUST_PROXY=false
EV_CORS_ALLOWED_ORIGINS=http://localhost:3000
EV_REQUEST_BODY_LIMIT_BYTES=10485760

# --- PostgreSQL 16 ----------------------------------------------------------
# Runtime role: NOT superuser, NOT BYPASSRLS (row-level security must apply).
EV_DATABASE_URL=postgresql://evidencevault:changeme-local-only@localhost:5432/evidencevault
# Migration role (owns schema; used only by `prisma migrate deploy`).
EV_DATABASE_MIGRATION_URL=postgresql://evidencevault_migrator:changeme-local-only@localhost:5432/evidencevault

# --- Redis 7 ----------------------------------------------------------------
EV_REDIS_URL=redis://localhost:6379

# --- OpenSearch 2.x ---------------------------------------------------------
EV_OPENSEARCH_URL=http://localhost:9200
EV_OPENSEARCH_USERNAME=
EV_OPENSEARCH_PASSWORD=
EV_OPENSEARCH_INDEX_PREFIX=evidencevault

# --- Object storage: Wasabi in production, MinIO locally --------------------
# Wasabi example endpoint: https://s3.us-east-1.wasabisys.com (see
# docs/guides/wasabi-setup.md for bucket policy, versioning, and Object Lock).
EV_S3_ENDPOINT=http://localhost:9000
EV_S3_REGION=us-east-1
EV_S3_BUCKET_EVIDENCE=ev-evidence
EV_S3_BUCKET_QUARANTINE=ev-quarantine
EV_S3_ACCESS_KEY_ID=minioadmin
EV_S3_SECRET_ACCESS_KEY=minioadmin-local-only
# Path-style is required for MinIO; Wasabi supports virtual-hosted style too.
EV_S3_FORCE_PATH_STYLE=true
# Presigned URL lifetime (30–3600 s). Keep short; URLs are minted only after
# server-side authorization.
EV_S3_PRESIGN_TTL_SECONDS=300

# --- Authentik OIDC (application login) --------------------------------------
# See docs/guides/authentik-setup.md and infra/authentik/blueprint.yaml.
EV_OIDC_ISSUER=http://localhost:9443/application/o/evidencevault/
EV_OIDC_CLIENT_ID=evidencevault
EV_OIDC_CLIENT_SECRET=changeme-local-only
# Optional group→role mapping. Leave EV_OIDC_GROUP_CLAIM empty to manage roles
# inside AEG-CloudDFIR instead.
EV_OIDC_GROUP_CLAIM=
EV_OIDC_GROUP_ROLE_MAP=
# 32+ chars; encrypts/signs the session cookie. Generate: openssl rand -hex 32
EV_SESSION_SECRET=changeme-generate-a-random-64-char-hex-string-for-real-use!!
EV_SESSION_TTL_SECONDS=28800

# --- Envelope encryption for connector secrets --------------------------------
# Local portable KEK provider. For AWS KMS / GCP KMS / Vault adapters see
# docs/guides/key-management.md. Generate: openssl rand -base64 32
EV_KEK_PROVIDER=local-aes256gcm
EV_KEK_LOCAL_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
EV_KEK_ACTIVE_KEY_ID=kek-1

# --- Microsoft identity platform (AEG-CloudDFIR's app registration) ----------
# docs/guides/microsoft-setup.md. Leave empty to disable Microsoft connectors.
EV_MS_CLIENT_ID=
EV_MS_CLIENT_SECRET=
EV_MS_REDIRECT_PATH=/api/v1/connectors/callback/microsoft

# --- Google OAuth (AEG-CloudDFIR's OAuth client) ------------------------------
# docs/guides/google-setup.md. Leave empty to disable Google connectors.
EV_GOOGLE_CLIENT_ID=
EV_GOOGLE_CLIENT_SECRET=
EV_GOOGLE_REDIRECT_PATH=/api/v1/connectors/callback/google

# --- Provider endpoint overrides (tests/demo ONLY; keep defaults in prod) ----
EV_MS_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
EV_MS_LOGIN_BASE_URL=https://login.microsoftonline.com
EV_GOOGLE_API_BASE_URL=https://www.googleapis.com
EV_GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token

# --- ClamAV -------------------------------------------------------------------
EV_CLAMAV_HOST=localhost
EV_CLAMAV_PORT=3310
EV_CLAMAV_ENABLED=true

# --- Extraction & processing limits -------------------------------------------
EV_TIKA_URL=http://localhost:9998
EV_OCR_LANGS=eng
EV_MAX_ARCHIVE_DEPTH=3
EV_MAX_ARCHIVE_EXPANSION_RATIO=100
EV_MAX_ARCHIVE_TOTAL_BYTES=2147483648
EV_MAX_OCR_PAGES=2000
EV_PREVIEW_TIMEOUT_MS=120000

# --- Demo seed mode ------------------------------------------------------------
# Enables the clearly-labeled local demo: seeded fake Microsoft/Google provider
# server and sample tenants. Refused when NODE_ENV=production.
EV_DEMO_MODE=false
EV_DEMO_FAKE_PROVIDER_URL=http://localhost:4010

# --- Observability --------------------------------------------------------------
EV_LOG_LEVEL=info
EV_OTEL_EXPORTER_OTLP_ENDPOINT=
EV_METRICS_PORT=9464

# ============================================================================
# AEG-CloudDFIR environment configuration
# Copy to .env and adjust. Every service validates this at startup and exits
# with a per-key error report if anything is missing or malformed.
# NEVER commit a real .env. Values below are local-development placeholders
# that match infra/compose/docker-compose.yml, not production secrets.
# ============================================================================

NODE_ENV=development
CDFIR_APP_VERSION=0.1.0

# --- HTTP -------------------------------------------------------------------
CDFIR_API_PORT=4000
CDFIR_API_PUBLIC_URL=http://localhost:4000
CDFIR_WEB_PUBLIC_URL=http://localhost:3000
# Set true only behind a TLS-terminating reverse proxy that sets X-Forwarded-*
CDFIR_TRUST_PROXY=false
CDFIR_CORS_ALLOWED_ORIGINS=http://localhost:3000
CDFIR_REQUEST_BODY_LIMIT_BYTES=10485760

# --- PostgreSQL 16 ----------------------------------------------------------
# Password for the cdfir / cdfir_migrator database roles. Used by the compose
# postgres init script on FIRST start and by the api/worker connection URLs.
# Production: generate one (`openssl rand -hex 24`) BEFORE the first `up`.
CDFIR_DB_PASSWORD=changeme-local-only
# Runtime role: NOT superuser, NOT BYPASSRLS (row-level security must apply).
CDFIR_DATABASE_URL=postgresql://cdfir:changeme-local-only@localhost:5432/cdfir
# Migration role (owns schema; used only by `prisma migrate deploy`).
CDFIR_DATABASE_MIGRATION_URL=postgresql://cdfir_migrator:changeme-local-only@localhost:5432/cdfir

# --- Redis 7 ----------------------------------------------------------------
CDFIR_REDIS_URL=redis://localhost:6379

# --- OpenSearch 2.x ---------------------------------------------------------
CDFIR_OPENSEARCH_URL=http://localhost:9200
# OpenSearch requires authentication by default (see infra/compose). Create this
# user once with docs/runbooks/opensearch-security.md; without credentials every
# search returns 401. Leave blank ONLY together with
# CDFIR_OPENSEARCH_SECURITY_DISABLED=true below.
CDFIR_OPENSEARCH_USERNAME=cdfir_app
CDFIR_OPENSEARCH_PASSWORD=
CDFIR_OPENSEARCH_INDEX_PREFIX=cdfir
# Uncomment for a throwaway LOCAL stack only. With security off, anything that can
# reach the port reads every indexed document with no credentials.
#CDFIR_OPENSEARCH_SECURITY_DISABLED=true

# --- Object storage: Wasabi in production, MinIO locally --------------------
# Wasabi example endpoint: https://s3.us-east-1.wasabisys.com (see
# docs/guides/wasabi-setup.md for bucket policy, versioning, and Object Lock).
# Local MinIO by default. For production, see docs/guides/wasabi-storage.md —
# the endpoint hostname encodes the region and CDFIR_S3_REGION must match it, or
# every request fails signature verification (which looks like an auth error).
CDFIR_S3_ENDPOINT=http://localhost:9000
CDFIR_S3_REGION=us-east-1
CDFIR_S3_BUCKET_EVIDENCE=cdfir-evidence
CDFIR_S3_BUCKET_QUARANTINE=cdfir-quarantine
CDFIR_S3_ACCESS_KEY_ID=minioadmin
# For the local MinIO this MUST equal CDFIR_LOCAL_MINIO_PASSWORD below, or every
# request fails with SignatureDoesNotMatch. Leaving this at the placeholder while
# generating a real MinIO password is a silent break: the API starts fine and
# fails on the first evidence write. /readyz now probes object storage, so the
# mismatch shows up there instead of at collection time.
CDFIR_S3_SECRET_ACCESS_KEY=minioadmin-local-only
# Path-style is required for MinIO; Wasabi supports virtual-hosted style too.
CDFIR_S3_FORCE_PATH_STYLE=true
# Presigned URL lifetime (30–3600 s). Keep short; URLs are minted only after
# server-side authorization.
CDFIR_S3_PRESIGN_TTL_SECONDS=300

# --- Authentik OIDC (application login) --------------------------------------
# See docs/guides/authentik-setup.md and infra/authentik/blueprint.yaml.
CDFIR_OIDC_ISSUER=http://localhost:9443/application/o/cdfir/
CDFIR_OIDC_CLIENT_ID=cdfir
CDFIR_OIDC_CLIENT_SECRET=changeme-local-only
# Optional group→role mapping. Leave CDFIR_OIDC_GROUP_CLAIM empty to manage roles
# inside AEG-CloudDFIR instead.
CDFIR_OIDC_GROUP_CLAIM=
CDFIR_OIDC_GROUP_ROLE_MAP=
# 32+ chars; encrypts/signs the session cookie. Generate: openssl rand -hex 32
CDFIR_SESSION_SECRET=changeme-generate-a-random-64-char-hex-string-for-real-use!!
CDFIR_SESSION_TTL_SECONDS=28800

# --- Envelope encryption for connector secrets --------------------------------
# Local portable KEK provider. For AWS KMS / GCP KMS / Vault adapters see
# docs/guides/key-management.md. Generate: openssl rand -base64 32
CDFIR_KEK_PROVIDER=local-aes256gcm
CDFIR_KEK_LOCAL_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
CDFIR_KEK_ACTIVE_KEY_ID=kek-1

# --- Microsoft identity platform (AEG-CloudDFIR's app registration) ----------
# docs/guides/microsoft-setup.md. Leave empty to disable Microsoft connectors.
CDFIR_MS_CLIENT_ID=
CDFIR_MS_CLIENT_SECRET=
CDFIR_MS_REDIRECT_PATH=/api/v1/connectors/callback/microsoft

# --- Google OAuth (AEG-CloudDFIR's OAuth client) ------------------------------
# docs/guides/google-setup.md. Leave empty to disable Google connectors.
CDFIR_GOOGLE_CLIENT_ID=
CDFIR_GOOGLE_CLIENT_SECRET=
CDFIR_GOOGLE_REDIRECT_PATH=/api/v1/connectors/callback/google

# --- Dropbox OAuth (AEG-CloudDFIR's Dropbox app) ------------------------------
# docs/guides/dropbox-setup.md. Leave empty to disable Dropbox connectors.
# App key and secret come from https://www.dropbox.com/developers/apps.
# No quotes around values: compose passes the quotes into the value.
CDFIR_DROPBOX_CLIENT_ID=
CDFIR_DROPBOX_CLIENT_SECRET=
CDFIR_DROPBOX_REDIRECT_PATH=/api/v1/connectors/callback/dropbox

# --- Provider endpoint overrides (tests/demo ONLY; keep defaults in prod) ----
CDFIR_MS_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
CDFIR_MS_LOGIN_BASE_URL=https://login.microsoftonline.com
CDFIR_GOOGLE_API_BASE_URL=https://www.googleapis.com
CDFIR_GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token

# --- ClamAV -------------------------------------------------------------------
CDFIR_CLAMAV_HOST=localhost
CDFIR_CLAMAV_PORT=3310
CDFIR_CLAMAV_ENABLED=true

# --- Uploaded container files (PST/OST) ---------------------------------------
# Max accepted upload size in bytes (default 10 GiB) and the per-container cap
# on extracted messages (extraction stops honestly with an exception beyond it).
CDFIR_UPLOAD_MAX_BYTES=10737418240
CDFIR_PST_MAX_MESSAGES=250000

# --- Extraction & processing limits -------------------------------------------
CDFIR_TIKA_URL=http://localhost:9998
CDFIR_OCR_LANGS=eng
CDFIR_MAX_ARCHIVE_DEPTH=3
CDFIR_MAX_ARCHIVE_EXPANSION_RATIO=100
CDFIR_MAX_ARCHIVE_TOTAL_BYTES=2147483648
CDFIR_MAX_OCR_PAGES=2000
CDFIR_PREVIEW_TIMEOUT_MS=120000

# --- Demo seed mode ------------------------------------------------------------
# Enables the clearly-labeled local demo: seeded fake Microsoft/Google provider
# server and sample tenants. Refused when NODE_ENV=production.
CDFIR_DEMO_MODE=false
CDFIR_DEMO_FAKE_PROVIDER_URL=http://localhost:4010

# --- Host port bindings (compose only) --------------------------------------
# Only needed when the defaults collide with something already on the host.
# Containers talk to each other over the compose network regardless.
#CDFIR_PG_HOST_PORT=5432
#CDFIR_REDIS_HOST_PORT=6379
#CDFIR_OPENSEARCH_HOST_PORT=9200
#CDFIR_MINIO_HOST_PORT=9000
#CDFIR_MINIO_CONSOLE_HOST_PORT=9001
#CDFIR_TIKA_HOST_PORT=9998
#CDFIR_CLAMAV_HOST_PORT=3310
#CDFIR_AUTHENTIK_HOST_PORT=9443
#CDFIR_API_HOST_PORT=4000
#CDFIR_WEB_HOST_PORT=3000

# --- Observability --------------------------------------------------------------
CDFIR_LOG_LEVEL=info
CDFIR_OTEL_EXPORTER_OTLP_ENDPOINT=
CDFIR_METRICS_PORT=9464

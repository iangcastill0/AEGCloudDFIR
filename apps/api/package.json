{
  "name": "@aeg-clouddfir/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "dev": "sh -c 'tsc -p tsconfig.json --watch --preserveWatchOutput & tsc_pid=$!; trap \"kill $tsc_pid 2>/dev/null\" EXIT; node --watch --env-file-if-exists=../../.env dist/main.js'",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@aeg-clouddfir/config": "workspace:*",
    "@aeg-clouddfir/connectors": "workspace:*",
    "@aeg-clouddfir/contracts": "workspace:*",
    "@aeg-clouddfir/database": "workspace:*",
    "@aeg-clouddfir/evidence": "workspace:*",
    "@aeg-clouddfir/production": "workspace:*",
    "@aeg-clouddfir/search": "workspace:*",
    "@aws-sdk/client-s3": "3.1105.0",
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.3.1",
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-fastify": "^10.4.22",
    "fastify": "^4.29.1",
    "jose": "6.2.8",
    "openid-client": "6.8.4",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@types/node": "26.1.2",
    "eslint": "^10.8.0",
    "tsx": "^4.23.9",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}

<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tika with OCR turned off.

  The apache/tika:*-full image bundles Tesseract, so Tika runs OCR on any image
  it meets inside a document. That is useful, but it competes for the same cores
  as the worker's own OCR stage, which has a policy (ocr-policy.ts) and proper
  instrumentation. This config excludes the Tesseract parser so extraction is
  text-only and anything that needs OCR falls to that dedicated stage.

  Used by BOTH production and staging Tika. The trade was measured on staging
  first (see docker-compose.staging.yml): text-only extraction loses OCR for
  ~0.4% of items (Office docs with embedded images that OCR pushed past
  LOW_TEXT_THRESHOLD), in exchange for removing the duplicate Tesseract load
  that saturated the shared host. Images and PDFs are still OCR'd by the
  dedicated worker stage (ocr-policy.ts).
-->
<properties>
  <parsers>
    <parser class="org.apache.tika.parser.DefaultParser">
      <parser-exclude class="org.apache.tika.parser.ocr.TesseractOCRParser"/>
    </parser>
  </parsers>
</properties>

# Staging configuration. Copy to .env.staging on the server and fill in.
#
# Staging is a SECOND stack on the same host. Everything below is deliberately
# different from production's .env — reusing a production value here is how
# staging ends up writing to real evidence.
#
#   cp .env.staging.example .env.staging && chmod 600 .env.staging

NODE_ENV=production
CDFIR_APP_VERSION=staging

# --- Where staging lives -----------------------------------------------------
CDFIR_WEB_PUBLIC_URL=https://staging.aegclouddfir.com
CDFIR_API_PUBLIC_URL=https://api-staging.aegclouddfir.com
CDFIR_CORS_ALLOWED_ORIGINS=https://staging.aegclouddfir.com
CDFIR_TRUST_PROXY=true

# --- Host ports (all localhost-only; nginx is the only way in) ---------------
CDFIR_WEB_HOST_PORT=3100
CDFIR_API_HOST_PORT=4100
CDFIR_PG_HOST_PORT=55433
CDFIR_REDIS_HOST_PORT=56380

# --- Its own database. NOT production's. -------------------------------------
# Generate: openssl rand -base64 24 | tr -d '/+='
CDFIR_LOCAL_PG_SUPER_PASSWORD=
CDFIR_DB_PASSWORD=

# --- Secrets, all distinct from production ----------------------------------
# openssl rand -hex 32
CDFIR_SESSION_SECRET=
# openssl rand -base64 32
CDFIR_KEK_LOCAL_MASTER_KEY=

# --- Sign-in: staging's own Authentik application ---------------------------
# Created by the blueprint; the secret must match what Authentik holds.
CDFIR_OIDC_ISSUER=https://auth.aegclouddfir.com/application/o/cdfir-staging/
CDFIR_OIDC_CLIENT_ID=cdfir-staging
CDFIR_OIDC_CLIENT_SECRET=
CDFIR_OIDC_REDIRECT_URI=https://api-staging.aegclouddfir.com/auth/callback

# --- Evidence storage: staging's OWN Wasabi buckets -------------------------
# Wasabi, not the MinIO on this host, for two reasons:
#  - a browser cannot resolve http://minio:9000, so download links signed for it
#    failed with ERR_NAME_NOT_RESOLVED (the URL host is part of the signature, so
#    it cannot be swapped afterwards)
#  - staging then exercises the real storage engine: Object Lock, multipart copy
#    above 5 GiB, signed download filenames. With MinIO none of that was tested.
#
# The access key MUST be scoped to these buckets only. Staging having a key that
# can read production evidence would undo the point of a separate environment.
CDFIR_S3_ENDPOINT=https://s3.us-east-1.wasabisys.com
CDFIR_S3_REGION=us-east-1
CDFIR_S3_FORCE_PATH_STYLE=true
CDFIR_S3_BUCKET_EVIDENCE=
CDFIR_S3_BUCKET_QUARANTINE=
CDFIR_S3_ACCESS_KEY_ID=
CDFIR_S3_SECRET_ACCESS_KEY=

# --- Search: staging's OWN OpenSearch cluster -------------------------------
# Not production's. A shared cluster meant one JVM heap and one shard budget, so
# a staging reindex competed with production searches. This one runs on half the
# heap and is reached as opensearch-staging on the docker network.
# NOTE: the disk is still shared. A full disk turns BOTH clusters read-only.
CDFIR_STAGING_OS_ADMIN_PASSWORD=
CDFIR_OPENSEARCH_HOST_PORT=59201
CDFIR_OPENSEARCH_INDEX_PREFIX=cdfir-staging
CDFIR_OPENSEARCH_USERNAME=cdfir_staging
CDFIR_OPENSEARCH_PASSWORD=

# --- The image tag currently deployed (managed by scripts/deploy-staging.sh) -
CDFIR_IMAGE_TAG=main
